name: Test Fixtur.es Importer

on:
  workflow_dispatch:

  push:
    paths:
      - "sources/fixtur_es.py"
      - ".github/workflows/test-fixtur-es.yml"

jobs:
  test-fixtur-es:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Run Fixtur.es importer
        run: |
          python sources/fixtur_es.py
